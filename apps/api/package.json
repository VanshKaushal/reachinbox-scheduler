    "connect-redis": "^8.1.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "express-session": "^1.18.2",
    "google-auth-library": "^10.4.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.8.1",
    "mysql2": "^3.15.3",
    "nodemailer": "^10.0.15",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "redis": "^4.7.1",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
