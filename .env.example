# Copy to .env at the repository root. Never commit .env.
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:5173
API_URL=http://localhost:4000
DATABASE_URL=mysql://reachinbox:reachinbox_dev@localhost:3307/reachinbox
REDIS_URL=redis://localhost:6380
ELASTICSEARCH_URL=http://localhost:9201
ELASTICSEARCH_INDEX=reachinbox-emails
SESSION_SECRET=replace-with-at-least-32-random-characters
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=replace-with-64-hex-characters
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google authorized redirect URI: http://localhost:4000/api/auth/google/callback
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Slack redirect URI: http://localhost:4000/api/integrations/slack/callback
WORKER_CONCURRENCY=8
MIN_SEND_DELAY_MS=2000
MAX_EMAILS_PER_HOUR_PER_SENDER=200
SMTP_TIMEOUT_MS=25000
SEND_LEASE_MS=60000
MAX_SEND_ATTEMPTS=4
OUTBOX_POLL_MS=500
# Local-only, clearly labelled demo access. Refused in production.
DEMO_MODE=false
# Comma-separated Google account emails allowed to access the read-only Bull Board.
QUEUE_ADMIN_EMAILS=
